APP_ENV=local
APP_DEBUG=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=daily_organizer
POSTGRES_USER=daily_organizer
POSTGRES_PASSWORD=daily_organizer

DATABASE_URL=postgresql+asyncpg://daily_organizer:daily_organizer@localhost:5432/daily_organizer
TEST_DATABASE_URL=postgresql+asyncpg://daily_organizer:daily_organizer@localhost:5432/daily_organizer_test

JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_SECRET_KEY=change-me-in-local-env
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
